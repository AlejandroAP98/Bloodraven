# Bloodraven - copia este archivo a `.env` y ajusta los valores
# DATABASE_URL es obligatorio: apunta a tu PostgreSQL local
DATABASE_URL=postgresql+asyncpg://bloodraven:CAMBIA_ESTA_CLAVE@localhost:5432/bloodraven
HOST=127.0.0.1
PORT=8080

# probes / motor de monitoreo (opcionales; tienen default razonable)
PING_TIMEOUT_MS=1000
MAX_PINGS_CONCURRENTES=50
MAX_TRACERTS_CONCURRENTES=4
HOP_SCAN_INTERVAL_MIN=10
N_FALLOS_DOWN=3
N_MUESTRAS_DEGRADADO=4

# retencion y consolidacion nocturna (opcional)
RETENCION_RAW_DIAS=30
RETENCION_1MIN_DIAS=180
CONSOLIDADOR_HORA=3

# UI: icono de bandeja (0 = servidor headless)
BANDEJA=true

# alertas (opcionales)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# clave Fernet para cifrar las credenciales de equipos (opcional):
# si se deja vacia, Bloodraven genera una y la guarda en credencial_clave.key
# (fuera de git). Definela si quieres poder regenerar/restaurar la misma clave.
CREDENCIAL_CLAVE=
